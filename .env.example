DISCORD_TOKEN=tu_token_aqui

# Segundos de enfriamiento de Disboard (7200 = 2 horas). Opcional, si no lo pones usa 7200 por defecto.
TIEMPO_ENFRIAMIENTO=7200

# Ruta del archivo de base de datos SQLite
DB_PATH=bumpbot.db

# Emoji personalizado opcional para el aviso (solo el ID)
EMOJI_BUMP_ID=
EMOJI_ANIMADO=false

# Comunidades de Lemmy para los memes en video, separadas por coma (formato nombre@instancia).
# Opcional, si no lo pones usa memes, lemmyshitpost y funny de lemmy.world.
LEMMY_COMUNIDADES=memes@lemmy.world,lemmyshitpost@lemmy.world,funny@lemmy.world