DISCORD_TOKEN=tu_token_aqui

# Segundos de enfriamiento de Disboard (7200 = 2 horas). Opcional, si no lo pones usa 7200 por defecto.
TIEMPO_ENFRIAMIENTO=7200

# Ruta del archivo de base de datos SQLite
DB_PATH=bumpbot.db

# Emoji personalizado opcional para el aviso (solo el ID)
EMOJI_BUMP_ID=
EMOJI_ANIMADO=false
